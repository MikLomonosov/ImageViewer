<Window x:Class="ImageViewer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ImageViewer.Wpf"
        xmlns:vm="clr-namespace:ImageViewer.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="ImageViewer" Height="600" Width="600">
    
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Command="{Binding LoadImagesCommand}"
                    Padding="12,6"
                    Cursor="Hand"
                    Margin="0 0 10 0"
                    Height="50"
                    Width="110"
                    Background="#1A73E8">
                <TextBlock Text="Загрузить изображения"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="#FFFFFF"/>
            </Button>
            <Button Command="{Binding SerializeCollectionCommand}"
                    Padding="12,6"
                    Cursor="Hand"
                    Margin="0 0 10 0"
                    Height="50"
                    Width="110"
                    Background="#E2EAE4">
                <TextBlock Text="Сохранить в файл"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="#1C2E24"/>
            </Button>
            <Button Command="{Binding DeserializeCollectionCommand}"
                    Padding="12,6"
                    Cursor="Hand"
                    Margin="0 0 10 0"
                    Height="50"
                    Width="110"
                    Background="#28A745">
                <TextBlock Text="Открыть из файла"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="#FFFFFF"/>
            </Button>
            <Button Command="{Binding ClearCommand}"
                    Padding="12,6"
                    Cursor="Hand"
                    Margin="0 0 10 0"
                    Height="50"
                    Width="110"
                    Background="#DC3545">
                <TextBlock Text="Очистить список"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="White"/>
            </Button>
            
            
            <TextBlock Text="Загрузка..."
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>
        
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Images}"
                 SelectionMode="Single"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel">
            
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ListBox.ItemContainerStyle>
            
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ImageItemViewModel}">
                    <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: thumbnail -->
                            <Border Grid.Column="0" Width="90" Height="90"
                                    Background="#F0F0F0"
                                    VerticalAlignment="Center">
                                <Image Source="{Binding Thumbnail}"
                                       Stretch="Uniform" />
                            </Border>

                            <!-- Right: details -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="14" />
                                <TextBlock Text="{Binding SizeFormatted}" Opacity="0.7" />
                                <TextBlock Text="{Binding CreatedDateFormatted}" Opacity="0.7" />
                                <TextBlock Text="{Binding DimensionsFormatted}" Opacity="0.7" />
                                <TextBlock Text="{Binding Path}" Opacity="0.7" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            
        </ListBox>

    </Grid>
</Window>
